# Copy to .env for local development, or set the same keys in the Netlify UI
# (Site configuration → Environment variables). VITE_* values are baked in at
# build time and must be present when `npm run build` runs.

# --- Required for a useful hosted demo ---
DEMO_MODE=true
VITE_DEMO_MODE=true
JWT_SECRET=change-me-to-a-long-random-string

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# --- Chain (leave unset to browse the catalog without on-chain features) ---
# VITE_ENABLE_TESTNETS=true
# VITE_ALLOWED_CHAINS=sepolia
# CHAIN_ID=11155111
# CHAIN_RPC_URL=https://sepolia.drpc.org
# VITE_IDENTITY_REGISTRY_ADDRESS=
# VITE_CLAIM_ISSUER_ADDRESS=
# VITE_INVESTOR_ONBOARDER_ADDRESS=
# VITE_USDC_ADDRESS=
# VITE_PROPERTY_FACTORY_ADDRESS=
# VITE_SHARE_MARKET_ADDRESS=

# Optional MoonPay handoff on Get USDC
# VITE_MOONPAY_PUBLISHABLE_KEY=
# VITE_MOONPAY_SANDBOX=true
